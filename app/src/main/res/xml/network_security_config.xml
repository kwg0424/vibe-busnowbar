<?xml version="1.0" encoding="utf-8"?>
<!-- 서울시 버스 Open API(ws.bus.go.kr)가 http:// 로만 제공돼서, 이 호스트에만 평문 트래픽을 허용한다. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ws.bus.go.kr</domain>
    </domain-config>
</network-security-config>
