<?xml version="1.0" encoding="utf-8"?>
<!--
  BusNowBar 로고 — 정면 버스에 옆면을 살짝 보여주는 3/4 아이소메트릭 형태.

  면마다 명암이 필요해 다색으로 그린다.
  테마 아이콘(모노크롬)은 색이 무시되므로 ic_launcher_mono.xml 로 따로 둔다.

  좌표계: 앞면 (34,40)-(66,76), 깊이 벡터 (+10,-6) 만큼 밀어 윗면·옆면을 만든다.
  어댑티브 아이콘은 중앙 지름 66dp 만 안전하다 —
  모든 꼭짓점을 중심 (54,54) 반경 33 안에 넣어 어떤 마스크에서도 잘리지 않는다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 바퀴 -->
    <path
        android:fillColor="#FF1B2A3D"
        android:pathData="M38,76 h6 v3 h-6 Z M56,76 h6 v3 h-6 Z" />

    <!-- 앞면 (밝은 면) -->
    <path
        android:fillColor="#FFEDF2F0"
        android:pathData="M34,40 L66,40 L66,76 L34,76 Z" />

    <!-- 옆면 (그늘진 면) -->
    <path
        android:fillColor="#FFC9D6E6"
        android:pathData="M66,40 L76,34 L76,70 L66,76 Z" />

    <!-- 지붕 (윗면) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,40 L66,40 L76,34 L44,34 Z" />

    <!-- 앞유리 -->
    <path
        android:fillColor="#FF1B2A3D"
        android:pathData="M38,44 h24 v14 h-24 Z" />

    <!-- 옆유리 -->
    <path
        android:fillColor="#FF1B2A3D"
        android:pathData="M68,46.5 L74,43 L74,54 L68,57.5 Z" />

    <!-- 노선 띠 -->
    <path
        android:fillColor="#FFF2B544"
        android:pathData="M34,62 h32 v4 h-32 Z" />
    <path
        android:fillColor="#FFE0A235"
        android:pathData="M66,62 L76,56 L76,60 L66,66 Z" />

    <!-- 전조등 -->
    <path
        android:fillColor="#FFF2B544"
        android:pathData="M41,70.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z M54,70.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
</vector>
